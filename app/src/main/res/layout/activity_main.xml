<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:text="秒答 · 设置"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="接口（URL + Key 组合，可存多个一键切换）"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spProfile"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <EditText
            android:id="@+id/etBaseUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="接口地址，如 https://open.bigmodel.cn/api/paas/v4"
            android:inputType="textUri"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="该接口的 API Key（sk-...）"
            android:inputType="textVisiblePassword"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAddProfile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="＋新增接口"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnDelProfile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="删除当前接口"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="模型（当前接口下可存多个，下拉切换）"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spModel"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <EditText
            android:id="@+id/etNewModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="输入模型名，点下方添加（需支持图片输入）"
            android:inputType="text"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAddModel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="添加模型"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnDelModel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="删除当前模型"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="答题强度（模型输出 token 上限）"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/rgMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbLow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="低速 · 简单题，最省最快（512）"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbHigh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="均衡 · 日常默认，兼顾速度与准确（1024）"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbMax"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="极限 · 高数/力学/大物难题，足量思考（3000）"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbCustom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="自定义"
                android:textSize="14sp" />
        </RadioGroup>

        <EditText
            android:id="@+id/etCustomTokens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:hint="自定义 token 数（64~32000）"
            android:inputType="number"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="保存配置" />

        <Button
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="测试连接" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="启动悬浮球" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="停止悬浮球" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="状态：未启动"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:text="使用说明：\n1. 配置好接口/模型/强度后点「保存」，再「测试连接」；\n2. 点「启动悬浮球」，按提示授予两个系统权限；\n3. 切到题目界面，双击小圆点 → 识屏出答案；\n4. 单击圆点 → 弹出解析看模型思考；\n5. 题目超一屏：点开解析 → 「拼接下一屏」→ 滑动后再双击 → 单击作答（最多3屏）；\n6. 长按圆点 → 打开设置。\n\n提示：简单题用低速档最省；难题切极限档。若接口报错提示 token 超限，App 会自动降档重试一次。"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
